package {
    default_team: "trendy_team_desktop_connectivity",
}

rust_defaults {
    name: "libusbauthservice_defaults",
    edition: "2021",
    rustlibs: [
        "android.hardware.usb.auth-rust",
        "libtempfile",
        "libthiserror",
        "libueventd",
        "liblog_rust",
    ],
}

rust_library {
    name: "libusbauthservice_rules",
    crate_name: "usbauthservice_rules",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["rules.rs"],
    host_supported: true,
}

rust_test_host {
    name: "libusbauthservice_rules_test",
    crate_name: "usbauthservice_rules",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["rules.rs"],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

rust_library {
    name: "libusbauthservice_authorization",
    crate_name: "usbauthservice_authorization",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["authorization.rs"],
    rustlibs: [
        "libusbauthservice_device_info",
        "libusbauthservice_parser",
        "libusbauthservice_rules",
    ],
    host_supported: true,
}

rust_test_host {
    name: "libusbauthservice_authorization_test",
    crate_name: "usbauthservice_authorization",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["authorization.rs"],
    rustlibs: [
        "libusbauthservice_device_info",
        "libusbauthservice_parser",
        "libusbauthservice_rules",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

rust_library {
    name: "libusbauthservice_device_info",
    crate_name: "usbauthservice_device_info",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["device_info.rs"],
    host_supported: true,
}

rust_test_host {
    name: "libusbauthservice_device_info_test",
    crate_name: "usbauthservice_device_info",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["device_info.rs"],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

rust_library {
    name: "libusbauthservice_parser",
    crate_name: "usbauthservice_parser",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["parser.rs"],
    rustlibs: ["libusbauthservice_rules"],
    host_supported: true,
}

rust_test_host {
    name: "libusbauthservice_parser_test",
    crate_name: "usbauthservice_parser",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["parser.rs"],
    rustlibs: ["libusbauthservice_rules"],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}
