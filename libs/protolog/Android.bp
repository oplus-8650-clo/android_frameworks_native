package {
    default_applicable_licenses: ["frameworks_native_license"],
    default_team: "trendy_team_windowing_tools",
}

cc_defaults {
    name: "protolog_proto_deps",
    static_libs: [
        "libperfetto_client_experimental",
    ],

    whole_static_libs: [
        // TODO(b/169779783): move  into "static_libs" when the soong issue is fixed
        "perfetto_trace_protos",
    ],

    export_static_lib_headers: [
        "libperfetto_client_experimental",
        "perfetto_trace_protos",
    ],

    shared_libs: [
        "libprotobuf-cpp-lite",
    ],
}

cc_defaults {
    name: "protolog_all_deps",
    defaults: [
        "protolog_proto_deps",
    ],
    header_libs: [
        "protolog-cpp-headers",
    ],
    target: {
        android: {
            shared_libs: [
                "libutilscallstack",
                "libc++",
            ],
            static_libs: [
                "protolog-cpp",
                "android.tracing.flags_c_lib",
                "libaconfig_storage_read_api_cc",
            ],
        },
    },
}

cc_library_headers {
    name: "protolog-cpp-headers",
    host_supported: true,
    export_include_dirs: ["."],
}

cc_library_static {
    name: "protolog-cpp",
    srcs: [
        "ProtoLog.cpp",
        "ProtoLogDataSource.cpp",
        "ProtoLogTracer.cpp",
    ],
    export_include_dirs: ["."],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    static_libs: [
        "libperfetto_client_experimental",
        "android.tracing.flags_c_lib",
    ],
    shared_libs: [
        "libutilscallstack",
        "libutils",
        "liblog",
        // "libbacktrace",
    ],
    defaults: ["protolog_proto_deps"],
}

cc_test {
    name: "NativeProtologTests",
    srcs: ["ProtoLogTest.cpp"],

    static_libs: [
        "protolog-cpp",
        "libgmock",
        "libprotobuf-cpp-lite",
        "libperfetto_client_experimental",
        "perfetto_trace_protos",
        "android.tracing.flags_c_lib",
        "libflagtest",
        "trace_processor",
        "libz",
        "sqlite_ext_percentile",
        "libaconfig_storage_read_api_cc",
    ],

    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "server_configurable_flags",
        "libsqlite",
        "libz",
        "libutilscallstack",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    defaults: ["protolog_proto_deps"],

    test_suites: ["general-tests"],
}
