package: "com.android.graphics.egl.flags"
container: "system"

flag {
  name: "multifile_blobcache_advanced_usage"
  namespace: "gpu"
  description: "This flag controls new behaviors to address bugs found via advanced usage"
  bug: "380483358"
  is_fixed_read_only: true
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "do_not_unload_driver_from_updatable_apk"
  namespace: "gpu"
  description: "This flag controls behavior to address bugs in system driver unloading logic"
  bug: "448201398"
  is_fixed_read_only: true
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "multifile_blobcache_configurable_entry_limit"
  namespace: "gpu"
  description: "This flag controls usage of readonly properies to configure multifile blobcache entry limit"
  bug: "466445745"
  is_fixed_read_only: true
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "update_angle_feature_overrides_in_loader_open"
  namespace: "gpu"
  description: "This flag controls moving the call to updateAngleFeatureOverrides() from GraphicsEnv::setAngleInfo() to Loader::open()."
  bug: "461292354"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}
